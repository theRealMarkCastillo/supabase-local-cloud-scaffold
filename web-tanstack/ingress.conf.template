map $http_upgrade $connection_upgrade { default upgrade; '' close; }
server {
  listen ${PORT};
  server_tokens off;
  access_log off;
  client_max_body_size 3m;
  resolver ${DNS_RESOLVER} valid=5s;
  set $gateway "${API_UPSTREAM}";
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy same-origin always;
  set $app "app:3000";
  location / {
    proxy_pass http://$app;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    add_header Cache-Control "private, no-store" always;
  }
  location = /health { proxy_pass http://$app/health; }
  location ^~ /supabase/auth/v1/admin { return 404; }
  location ~ ^/supabase/(auth/v1/|rest/v1/|storage/v1/|functions/v1/|realtime/v1/|graphql/v1) {
    rewrite ^/supabase/(.*)$ /$1 break;
    proxy_pass http://$gateway;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 180s;
  }
  location /supabase/ { return 404; }
}
